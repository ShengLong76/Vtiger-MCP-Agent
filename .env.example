# Copy to .env and fill from your own Vtiger + Cloudflare consoles.
# Never commit real access keys or Access Service Token secrets.

# Path to the instance list (defaults to ./instances.yaml)
VTIGER_INSTANCES_FILE=./instances.yaml

# Used when a tool call omits `instance`
VTIGER_DEFAULT_INSTANCE=dragonsden

# HTTP timeout for webservice.php calls (milliseconds)
VTIGER_HTTP_TIMEOUT_MS=30000

# DESTRUCTIVE: set to true to allow vtiger_delete (still requires confirm=true)
VTIGER_ENABLE_DELETE=false

# --- Instance: dragonsden (https://crm.dragonsden.work) ---
# Username of the Vtiger webservice user (My Preferences → Access Key)
VTIGER_DRAGONSDEN_USERNAME=
VTIGER_DRAGONSDEN_ACCESS_KEY=

# Optional Cloudflare Access Service Token (Zero Trust → Access → Service Auth)
# Required for non-interactive Cos / Grok Bot when the CRM is behind Access.
VTIGER_DRAGONSDEN_CF_ACCESS_CLIENT_ID=
VTIGER_DRAGONSDEN_CF_ACCESS_CLIENT_SECRET=

# --- Instance: tecyeah (example second client — replace base_url in instances.yaml) ---
VTIGER_TECYEAH_USERNAME=
VTIGER_TECYEAH_ACCESS_KEY=
VTIGER_TECYEAH_CF_ACCESS_CLIENT_ID=
VTIGER_TECYEAH_CF_ACCESS_CLIENT_SECRET=
